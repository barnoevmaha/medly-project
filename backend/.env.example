# Copy to .env and edit.

# "dev" relaxes the startup checks, creates the demo accounts and enables the
# demo premium checkout. Anything else — including leaving it unset — is a real
# deployment, which refuses to start without a strong MEDLY_SECRET_KEY.
MEDLY_ENV=dev

# At least 32 characters outside dev. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDLY_SECRET_KEY=change-me-to-a-long-random-string
MEDLY_DATABASE_URL=sqlite:///./medly.db

# Access tokens are short-lived and cannot be revoked; the refresh token
# (httpOnly cookie, stored hashed, revoked on logout and password change)
# keeps the session alive between them.
MEDLY_ACCESS_TOKEN_MINUTES=15
MEDLY_REFRESH_TOKEN_DAYS=30
# Defaults: lax + not secure in dev (same-site localhost over http);
# none + secure otherwise (frontend and API on different sites).
# MEDLY_REFRESH_COOKIE_SAMESITE=none
# MEDLY_REFRESH_COOKIE_SECURE=true

# Exactly these origins, comma-separated — no wildcards or patterns. Add every
# frontend hostname (production and each preview you want to use) explicitly.
MEDLY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login and registration attempts, per client IP and per email address.
MEDLY_AUTH_IP_RATE_LIMIT_PER_MINUTE=20
MEDLY_AUTH_IP_RATE_LIMIT_PER_HOUR=200
MEDLY_AUTH_EMAIL_RATE_LIMIT_PER_MINUTE=5
MEDLY_AUTH_EMAIL_RATE_LIMIT_PER_HOUR=30

# Re-run the seed on boot. Idempotent, and it means a fresh container or a wiped
# volume comes up with the curriculum and demo accounts already present.
MEDLY_SEED_ON_STARTUP=false
# The demo accounts share a published password. Always created in dev; set
# this to true to create them anywhere else (a public demo instance, say).
MEDLY_SEED_DEMO_USERS=false

# Assistant provider: "rules" needs no key and works offline (default).
# "gemini", "anthropic" or "openai" require the matching key below.
MEDLY_ASSISTANT_PROVIDER=rules
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Medly AI (Google Gemini) ------------------------------------------------
# Set MEDLY_ASSISTANT_PROVIDER=gemini to turn Medly AI on.
# This key is read by the API process only. It must never appear in the
# frontend, in a VITE_ variable, or in the repository.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Gemini 3.x thinks before it answers. Left at the default the model is silent
# for seconds and then delivers the answer in a few big pieces, which looks
# exactly like broken streaming. "low" favours first-token latency; "high" for
# harder questions; empty to send no preference at all.
GEMINI_THINKING_LEVEL=low

# SSE comment padding sent before the first real frame, to stop a buffering
# proxy holding the stream open and silent. 0 disables it.
MEDLY_SSE_PREAMBLE_BYTES=2048

# Timestamped [GEMINI-STREAM]/[SSE] logs, and enables GET /api/assistant/debug-stream.
# Turn on to diagnose streaming, then turn back off.
MEDLY_STREAM_DEBUG=false

# --- Virtual Patient ----------------------------------------------------------
# The simulator's own Gemini credentials, so it can sit on a different key,
# project or quota than the assistant and neither can exhaust the other.
# Leave the key empty to share GEMINI_API_KEY above — that is the right choice
# for a single-project deployment. Backend only; never a VITE_ variable.
#
# The simulation itself needs none of this. Clinical correctness, scoring,
# patient state and outcome are computed by the game engine offline; Gemini
# only phrases patient dialogue and the debrief, and every call falls back to
# the authored text if it fails.
VIRTUAL_PATIENT_GEMINI_API_KEY=
VIRTUAL_PATIENT_GEMINI_MODEL=gemini-3.5-flash
VIRTUAL_PATIENT_GEMINI_TIMEOUT_SECONDS=30
VIRTUAL_PATIENT_MAX_OUTPUT_TOKENS=400
VIRTUAL_PATIENT_DEBRIEF_MAX_OUTPUT_TOKENS=1200
# Paid narration calls per user. Past the limit the authored text is shown
# instead, exactly as when Gemini is down. Debriefs are cached per run.
VIRTUAL_PATIENT_RATE_LIMIT_PER_MINUTE=20
VIRTUAL_PATIENT_RATE_LIMIT_PER_HOUR=200

# Cost ceilings. Every one is enforced in code.
MEDLY_AI_MAX_MESSAGE_CHARS=4000
MEDLY_AI_MAX_OUTPUT_TOKENS=1600
MEDLY_AI_HISTORY_TURNS=6
MEDLY_AI_MAX_CONTEXT_CHARS=12000
MEDLY_AI_ARTICLE_CONTEXT_CHARS=6000

# Per-user request ceilings, counted per API process.
MEDLY_AI_RATE_LIMIT_PER_MINUTE=12
MEDLY_AI_RATE_LIMIT_PER_HOUR=120

# Article comments and community messages, per user.
MEDLY_POST_RATE_LIMIT_PER_MINUTE=6
MEDLY_POST_RATE_LIMIT_PER_HOUR=60

# Content translation (Russian, Uzbek) happens on first view, inside that
# request — at most this many seconds of it; the rest shows in English and is
# finished in the background.
MEDLY_TRANSLATE_BUDGET_SECONDS=10
# Without a Gemini key, translation falls back to two free public services
# that receive the text (including user-written community text). false keeps
# untranslated content in English instead.
MEDLY_FREE_TRANSLATE_FALLBACK=true

# Inference engine: "mock" (default) or "onnx" once you supply weights.
MEDLY_INFERENCE_ENGINE=mock
MEDLY_ONNX_MODEL_PATH=

# Safety thresholds
MEDLY_LOW_CONFIDENCE_THRESHOLD=0.70
MEDLY_CERTIFICATION_PASS_SCORE=80

# Stock imagery (https://www.pexels.com/api/). Server-side only — this key is
# never sent to the browser. Leave blank to disable stock lookups entirely:
# articles then keep their authored covers.
PEXELS_API_KEY=
PEXELS_TIMEOUT_SECONDS=10
